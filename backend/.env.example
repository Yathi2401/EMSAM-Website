PORT=5000
FRONTEND_URL=http://localhost:5173
# Use MongoDB Atlas or a local replica set for transactional Excel imports.
MONGODB_URI=mongodb://127.0.0.1:27017/emsam_db?replicaSet=rs0
# Optional: set only if your network cannot resolve Atlas SRV records.
# DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace_this_with_a_long_random_secret
ADMIN_EMAIL=admin@emsam.lk
# Required for database setup: use a unique password of at least 12 characters.
ADMIN_PASSWORD=
